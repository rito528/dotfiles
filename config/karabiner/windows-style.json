              ]
            }
          ],
          "from": {
            "key_code": "home",
            "modifiers": { "mandatory": [], "optional": [] }
          },
          "to": [ { "key_code": "left_arrow", "modifiers": ["left_command"] } ]
        },
        {
          "type": "basic",
          "conditions": [
